{
  "version": 1,
  "build": {
    "commands": [
      "dotnet build ScriptRunner/SolidDNA.ScriptRunner.sln --no-restore",
      "dotnet build SolidDna/AngelSix.SolidDna/AngelSix.SolidDna.sln --no-restore",
      "dotnet build Templates/SolidDNA.StandAlone/SolidDNA.StandAlone.sln --no-restore",
      "dotnet build Templates/SolidDna.Blank/SolidDNA.Blank.sln --no-restore",
      "dotnet build Templates/SolidDna.WPF.Blank/SolidDNA.WPF.Blank.sln --no-restore",
      "dotnet build \"Templates/VSIX Installer/SolidDNA.Templates.sln\" --no-restore",
      "dotnet build \"Tools/Addin Installer/AngelSix.SolidWorksApi.AddinInstaller.sln\" --no-restore",
      "dotnet build \"Tools/CommandManager Icon Generator/AngelSix.SolidWorksApi.IconGenerator.sln\" --no-restore",
      "dotnet build Tutorials/01-BlankAddin/AngelSix.SolidWorks.BlankAddin/AngelSix.SolidWorks.BlankAddin.sln --no-restore",
      "dotnet build Tutorials/02-WpfAddIn/SolidDna.WpfAddIn/SolidDna.WpfAddIn.sln --no-restore",
      "dotnet build Tutorials/03-CustomProperties/SolidDna.CustomProperties/SolidDna.CustomProperties.sln --no-restore",
      "dotnet build Tutorials/04-SelectedObjects/SolidDna.CustomProperties/SolidDna.CustomProperties.sln --no-restore",
      "dotnet build Tutorials/05-DynamicPlugInReload/SolidDna.DynamicLoadPlugIn/SolidDna.DynamicLoadPlugIn.sln --no-restore",
      "dotnet build Tutorials/06-Exporting/SolidDna.Exporting/SolidDna.Exporting.sln --no-restore",
      "dotnet build Tutorials/07-SolidDnaNuGet/SolidDnaNuGet.sln --no-restore",
      "dotnet build Tutorials/08-StandAlone/SolidDna.StandAlone.sln --no-restore"
    ]
  },
  "test": {
    "commands": []
  },
  "verify": {
    "includes": [
      "build",
      "test"
    ]
  },
  "sweep": {
    "commands": [
      "guard sweep ."
    ]
  },
  "checkup": {
    "commands": [
      "guard checkup ."
    ]
  },
  "all": {
    "includes": [
      "verify",
      "sweep"
    ]
  },
  "_comment_pre-push": [
    "The PUSH GATE: the security checks that must pass before anything leaves the machine.",
    "tracked-secrets catches a secret git already tracks (.gitignore cannot help there).",
    "web-exposure catches a static web root that is a source tree, a path gate that decides on the",
    "raw request path while the file is read from the decoded one, or credentials kept inside the",
    "served tree - the RetroSix Live disclosure of 29 Aug 2026. Fast; no build, no running app."
  ],
  "pre-push": {
    "expectedDurationSeconds": 15,
    "notice": "Push gate: security checks",
    "commands": [
      "guard security tracked-secrets .",
      "guard security web-exposure ."
    ]
  }
}
